      "DBType": 0,
      "Enabled": true,
      "IsDefault": true,
      "Connection": "Server=localhost;Port=3306;Database=rag_system;Uid=root;Pwd=ren@2025;"
    },
    {
      "ConnId": "2",
      "DBType": 0,
      "Enabled": true,
      "IsDefault": true,
      "Connection": "Server=localhost;Port=3306;Database=rag_system;Uid=root;Pwd=ren@2025;"
    }
  ]
